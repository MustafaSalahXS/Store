{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "turbo run build --filter=web",
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "outputDirectory": "apps/web/.next",
  "env": {
    "NODE_ENV": "production"
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": true
    }
  }
}
